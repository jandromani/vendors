{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile=false",
  "regions": ["cdg1"],
  "crons": [
    {
      "path": "/api/cron/pricing-agents",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/pricing-agents",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
